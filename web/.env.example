# Copy to .env.local and fill in after deploying (see ../docs/DEPLOYMENT.md).
# While any address is missing, the app runs on clearly labelled demo data.

VITE_EXIT_GUARD=
VITE_SENTINEL=
VITE_VAULT=
VITE_TIMELOCK=
VITE_TOKEN=

# Optional. Defaults to https://base-sepolia-rpc.publicnode.com. Do not use
# sepolia.base.org here: it limits log queries to 200 blocks.
VITE_BASE_SEPOLIA_RPC=

# How many blocks back to look for timelock and exit events. Base Sepolia has
# 200ms blocks, so 50000 blocks is under three hours.
VITE_LOOKBACK_BLOCKS=50000

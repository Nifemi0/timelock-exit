# Copy to .env and fill in. .env is git-ignored. Use a throwaway testnet key only.

# --- Keys (testnet only) ---
PRIVATE_KEY=

# --- Base Sepolia: where the timelock, the vault and ExitGuard live ---
BASE_SEPOLIA_RPC=https://sepolia.base.org
DESTINATION_CHAIN_ID=84532
# Callback proxy for Base Sepolia, from https://dev.reactive.network/origins-and-destinations
CALLBACK_PROXY_ADDR=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# --- Reactive Lasna: where TimelockSentinel lives ---
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007

# --- Demo settings ---
# Timelock delay in seconds for the demo stack. Keep it short for the video, long enough to see the exit.
DEMO_TIMELOCK_DELAY=300

# --- Filled in as you deploy (see docs/DEPLOYMENT.md) ---
SENTINEL_ADDR=
EXIT_GUARD_ADDR=
DEMO_TOKEN_ADDR=
DEMO_TIMELOCK_ADDR=
DEMO_VAULT_ADDR=
